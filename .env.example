# ==========================================================================
# MW — My Wear · environment
# Copy this file to .env.local and fill the values. Never commit .env.local.
# Secrets below are server-only: never prefix them with NEXT_PUBLIC_.
# NEXT_PUBLIC_SITE_URL is the one public value (it appears in canonical/OG tags).
# ==========================================================================

# Public site origin (canonical links, sitemap, robots, structured data)
# --------------------------------------------------------------------------
# The exact origin used in production, with no trailing slash:
#   NEXT_PUBLIC_SITE_URL=https://mywear.dz
# Set it in Vercel for Production (and Preview if you want previews to point
# at the same origin), then redeploy. If it is empty, production falls back to
# VERCEL_PROJECT_PRODUCTION_URL (with https://) and then to
# https://mw-my-wear.vercel.app. Local development uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional legacy name, still supported for existing deployments:
# SITE_URL=

# Order storage (Supabase, recommended for production)
# --------------------------------------------------------------------------
# Leave both values empty to store orders in .data/orders.json on this
# machine. That fallback is for local development only: serverless hosts do
# not keep local files between requests.
#
#   1. Create a project on https://supabase.com
#   2. Run supabase/schema.sql (then the files in supabase/migrations) in SQL Editor
#   3. Copy the Project URL and the *service role* / secret key here
#
# The service role key bypasses Row Level Security: it must only ever be used
# on the server. Never expose it in the browser or in NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where the local development fallback keeps orders.
# With NODE_ENV=production the app refuses to use a local file unless this is
# set explicitly, so a missing Supabase configuration fails loudly (HTTP 503)
# instead of silently losing orders on a serverless host.
# ORDERS_FILE=.data/orders.json

# Optional: where the local development fallback keeps delivery prices.
# Delivery prices normally live in the Supabase delivery_rates table and are
# edited from the admin dashboard. Without Supabase, the local file keeps them.
# In production a local file is refused unless this is set explicitly.
# DELIVERY_RATES_FILE=.data/delivery-rates.json

# Admin dashboard
# --------------------------------------------------------------------------
# Password typed at /ar/admin/login.
#   · at least 12 characters
#   · not a word from the shipped examples, not all letters or all digits
# ADMIN_PASSWORD=

# Signs the session cookie. Use a random string of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing ADMIN_SECRET or ADMIN_PASSWORD invalidates every open session.
ADMIN_SECRET=

# How long an admin session stays valid (hours, default 12, max 168).
# ADMIN_SESSION_HOURS=12

# Distributed rate limiting (optional but recommended on Vercel)
# --------------------------------------------------------------------------
# Without these, limits are tracked in memory and each serverless instance
# counts separately. Create a free Upstash Redis database and paste its REST
# credentials to share counters across instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
